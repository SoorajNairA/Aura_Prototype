# AURA local configuration template.
# Copy to .env and customize. Do not commit .env.

# Primary Engineering Workspace
AURA_WORKSPACE_HOST=127.0.0.1
AURA_WORKSPACE_PORT=8765
AURA_WORKSPACE_STORAGE_MODE=sqlite
# Defaults to the platform user-data directory (for example %LOCALAPPDATA%\AURA).
# AURA_DATA_DIR=C:\path\to\aura-data
# AURA_WORKSPACE_DB_PATH=C:\path\to\aura.db
# AURA_WORKSPACE_ARTIFACT_DIR=C:\path\to\artifacts
AURA_ARTIFACT_STORAGE_MODE=local
# Cloud-only storage configuration (Terraform supplies these in Cloud Run):
# AURA_WORKSPACE_STORAGE_MODE=postgres
# AURA_ARTIFACT_STORAGE_MODE=gcs
# AURA_GCS_BUCKET=private-bucket-name
# AURA_DATABASE_URL=postgresql://user:password@host/database
# AURA_DB_POOL_SIZE=3
# AURA_DB_MAX_OVERFLOW=1
# AURA_DB_POOL_TIMEOUT=5
# AURA_CLOUD_MODE=true
# Vertex Planner uses Application Default Credentials; no secret is stored here.
AURA_LLM_PROVIDER=vertex
AURA_GCP_PROJECT=your-gcp-project-id
AURA_GCP_LOCATION=global
AURA_VERTEX_MODEL=gemini-3.1-flash-lite
AURA_VERTEX_TIMEOUT_SECONDS=20
AURA_DETERMINISTIC_FALLBACK=true

# Compatibility assistant model routing
AURA_CONVERSATION_BACKEND=ollama
AURA_OLLAMA_BASE_URL=http://localhost:11434
AURA_OLLAMA_MODEL=auto
AURA_OLLAMA_PRIMARY_MODEL=qwen3:8b
AURA_OLLAMA_FALLBACK_MODEL=qwen2.5:3b
AURA_OLLAMA_TIMEOUT=120
AURA_OLLAMA_CONTEXT_LENGTH=8192
AURA_HARDWARE_PROFILE=auto
AURA_PERFORMANCE_MIN_RAM_GB=12
AURA_PERFORMANCE_MIN_VRAM_GB=6
AURA_XTTS_MIN_VRAM_GB=3.5

# Optional compatibility voice: speech-to-text
AURA_STT_MODEL=small
AURA_STT_DEVICE=cpu
AURA_STT_COMPUTE_TYPE=int8

# Optional compatibility voice: text-to-speech
AURA_TTS_BACKEND=auto
AURA_TTS_DEVICE=cuda
AURA_AUTO_WARMUP=true
# AURA_VOICE_REFERENCE=C:\path\to\voice.wav
# AURA_TTS_CACHE_DIR=C:\path\to\xtts-cache

# Optional local fallbacks
AURA_LOCAL_TTS_RATE=155
AURA_LOCAL_TTS_VOICE_INDEX=1

# Voice input
AURA_SAMPLE_RATE=16000
AURA_MAX_RECORD_SECONDS=12
AURA_SILENCE_THRESHOLD=0.01
AURA_SILENCE_HOLD_SECONDS=1.2
AURA_WAKE_WORD=aura

# Runtime storage
# AURA_MEMORY_DIR=C:\path\to\memory
# AURA_LOG_DIR=C:\path\to\logs
AUTO_REVEAL_RESULTS=true

# Safety confirmation
AURA_CONFIRM_WORDS=yes,confirm,proceed
AURA_REJECT_WORDS=no,stop,cancel
